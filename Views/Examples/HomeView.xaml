<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:mmlcontrols="clr-namespace:Mads195.MadsMauiLib.Controls;assembly=MadsMauiLib"
             x:Class="MadsMauiBase.Views.Examples.HomeView"
             Title="Home">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to home"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <mmlcontrols:SectionTitle Text="Hello Maddie!" />
        <mmlcontrols:Card
            Title="Popup Example"
            CardContent="See the MadsMauiLib FlexiPopup in action."
            ShowEditIcon="False"
            ShowTitle="True"
            ShowCardContent="True"
            Command="{Binding OpenPopupCommand}"
            Margin="0,0,0,10">
        </mmlcontrols:Card>

    </VerticalStackLayout>
</ContentPage>